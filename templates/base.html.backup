<!DOCTYPE html>
<html>
<head>
    <title>MotoGParr</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <meta name="theme-color" content="#52aad8">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icon-180x180.png">
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/icon-16x16.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/icon-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/assets/icon-512x512.png">
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
</head>
<body>
    <!-- Pull to refresh indicator -->
    <div class="pull-indicator" id="pull-indicator">
        <span class="pull-arrow">↓</span>
        <span class="pull-text">Pull to refresh</span>
    </div>

    <!-- Main content wrapper for swipe gestures -->
    <div class="content-wrapper" id="content-wrapper">
        <!-- Next Race Banner -->
        <div class="next-race-banner {{ 'race-now' if next_race.status == 'now' }}">
            {% if next_race.flag %}
            <div class="flag-avatar">
                <img src="/flags/{{ next_race.flag }}" alt="{{ next_race.venue }} flag">
            </div>
            {% endif %}
            <div class="race-info">
                <div class="race-title">
                    {% if next_race.status == 'now' %}
                    <span class="live-badge">LIVE</span> Race Weekend
                    {% else %}
                    Next Race
                    {% endif %}
                </div>
                <div class="race-venue">
                    {{ next_race.venue }}
                    {% if next_race.sprint_weekend %}<span class="sprint-badge">SPRINT</span>{% endif %}
                </div>
                {% if next_race.round %}
                <div class="race-details">Round {{ next_race.round }} • {{ next_race.date }}</div>
                {% endif %}
            </div>
            <div class="race-countdown">
                {% if next_race.status == 'now' %}
                    <div class="countdown-number">🏁</div>
                    <div class="countdown-label">Now!</div>
                {% elif next_race.days is not none %}
                    <div class="countdown-number">{{ next_race.days }}</div>
                    <div class="countdown-label">{{ 'day' if next_race.days == 1 else 'days' }} to go</div>
                {% else %}
                    <div class="countdown-label">{{ next_race.countdown }}</div>
                {% endif %}
            </div>
        </div>
        
        <div class="header-row">
            <div class="status {{ 'running' if status.running else 'ready' }}">
                {% if status.running %}⏳ Running: {{ status.command }}
                {% else %}✅ Idle{% endif %}
            </div>
        </div>

        <!-- Desktop Tabs (hidden on mobile) -->
        <div class="tabs desktop-only">
            <a href="/" class="tab {{ 'active' if active_tab == 'home' }}">Home</a>
            <a href="/library" class="tab {{ 'active' if active_tab == 'download' }}">Download</a>
            <a href="/settings-page" class="tab {{ 'active' if active_tab == 'settings' }}">Settings</a>
            <a href="/stats" class="tab {{ 'active' if active_tab == 'stats' }}">Stats</a>
            <a href="/calendar" class="tab {{ 'active' if active_tab == 'calendar' }}">Calendar</a>
            <a href="/activity" class="tab {{ 'active' if active_tab == 'activity' }}">Activity</a>
        </div>

        <!-- Page Content -->
        <div class="page-content">
            {% block content %}{% endblock %}
        </div>
    </div>

    <!-- Bottom Navigation (mobile only) -->
    <nav class="bottom-nav mobile-only">
        <a href="/" class="bottom-nav-item {{ 'active' if active_tab == 'home' }}">
            <span class="bottom-nav-icon">🏠</span>
            <span class="bottom-nav-label">Home</span>
        </a>
        <a href="/library" class="bottom-nav-item {{ 'active' if active_tab == 'download' }}">
            <span class="bottom-nav-icon">⬇️</span>
            <span class="bottom-nav-label">Download</span>
        </a>
        <a href="/settings-page" class="bottom-nav-item {{ 'active' if active_tab == 'settings' }}">
            <span class="bottom-nav-icon">⚙️</span>
            <span class="bottom-nav-label">Settings</span>
        </a>
        <a href="/stats" class="bottom-nav-item {{ 'active' if active_tab == 'stats' }}">
            <span class="bottom-nav-icon">📊</span>
            <span class="bottom-nav-label">Stats</span>
        </a>
        <a href="/calendar" class="bottom-nav-item {{ 'active' if active_tab == 'calendar' }}">
            <span class="bottom-nav-icon">📅</span>
            <span class="bottom-nav-label">Calendar</span>
        </a>
        <a href="/activity" class="bottom-nav-item {{ 'active' if active_tab == 'activity' }}">
            <span class="bottom-nav-icon">🏍️</span>
            <span class="bottom-nav-label">Activity</span>
        </a>
    </nav>

    <!-- Toast Container -->
    <div class="toast-container" id="toast-container"></div>

    <!-- Admin Password Modal -->
    <div class="modal-overlay" id="admin-modal" onclick="closeAdminModal(event)">
        <div class="modal-content modal-small" onclick="event.stopPropagation()">
            <div class="modal-header">
                <h3>🔐 Admin Access</h3>
                <button class="modal-close" onclick="closeAdminModal()">✕</button>
            </div>
            <div class="modal-body">
                <p>Enter admin password to access configuration:</p>
                <div class="form-group">
                    <input type="password" id="admin-password" placeholder="Password" onkeypress="if(event.key==='Enter')checkAdminPassword()">
                </div>
                <p class="admin-error" id="admin-error" style="display:none;">Incorrect password</p>
            </div>
            <div class="modal-footer">
                <button onclick="closeAdminModal()" class="secondary">Cancel</button>
                <button onclick="checkAdminPassword()" class="success">Submit</button>
            </div>
        </div>
    </div>

    <script>
        // ===== STICKY BANNER TOGGLE =====
        const STICKY_BANNER = true;
        // ================================
        
        // Plex brand colors for reference
        const PLEX_GAMBOGE = '#e5a00d';
        const PLEX_SHARK = '#282a2d';
        
        // MotoGParr brand colors
        const MOTOGP_PRIMARY = '#52aad8';
        const MOTOGP_PRIMARY_DARK = '#3d8ab8';
        
        const isRunning = {{ 'true' if status.running else 'false' }};
        const currentTab = '{{ active_tab }}';
        const tabs = ['home', 'download', 'settings', 'stats', 'calendar', 'activity'];
        const tabUrls = {
            'home': '/', 
            'download': '/library', 
            'settings': '/settings-page', 
            'stats': '/stats', 
            'calendar': '/calendar', 
            'activity': '/activity'
        };
        
        // Register Service Worker
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js')
                .then(reg => console.log('SW registered'))
                .catch(err => console.log('SW failed:', err));
        }
        
        {% if status.running %}
        // Don't auto-reload pages with live streams (activity, logs)
        const noReloadPages = ['activity', 'logs'];        
        if (!noReloadPages.includes(currentTab)) {
            setTimeout(() => location.reload(), 3000);
        }
        {% endif %}
        
        // Apply sticky setting
        document.addEventListener('DOMContentLoaded', function() {
            const banner = document.querySelector('.next-race-banner');
            if (banner && !STICKY_BANNER) {
                banner.classList.add('no-sticky');
            }
            
            // Add shadow when stuck
            if (banner && STICKY_BANNER) {
                const observer = new IntersectionObserver(
                    ([e]) => banner.classList.toggle('stuck', e.intersectionRatio < 1),
                    { threshold: [1], rootMargin: '-1px 0px 0px 0px' }
                );
                observer.observe(banner);
            }
        });
        
        // Admin modal functions
        let adminCallback = null;
        
        function showAdminModal(callback) {
            adminCallback = callback;
            document.getElementById('admin-password').value = '';
            document.getElementById('admin-error').style.display = 'none';
            document.getElementById('admin-modal').classList.add('active');
            document.getElementById('admin-password').focus();
        }
        
        function closeAdminModal(event) {
            if (!event || event.target.classList.contains('modal-overlay')) {
                document.getElementById('admin-modal').classList.remove('active');
                adminCallback = null;
            }
        }
        
        function checkAdminPassword() {
            const password = document.getElementById('admin-password').value;
            
            fetch('/verify-admin', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({password: password})
            })
            .then(r => r.json())
            .then(data => {
                if (data.valid) {
                    closeAdminModal();
                    sessionStorage.setItem('adminAuth', 'true');
                    if (adminCallback) adminCallback();
                } else {
                    document.getElementById('admin-error').style.display = 'block';
                    document.getElementById('admin-password').value = '';
                }
            });
        }
        
        function isAdminAuthed() {
            return sessionStorage.getItem('adminAuth') === 'true';
        }
    </script>
    <script src="{{ url_for('static', filename='js/app.js') }}"></script>
    {% block scripts %}{% endblock %}
</body>
</html>