{% extends "base.html" %}

{% block content %}
<div class="card">
    <div class="activity-header">
        <h2>🏁 Activity Feed</h2>
        <div class="activity-controls">
            <span class="live-indicator" id="live-indicator">● Live</span>
            <button onclick="clearActivity()" class="small secondary">Clear</button>
        </div>
    </div>
    
    <div class="activity-feed" id="activity-feed">
        <div class="activity-empty">
            <p>No recent activity. Start a download to see progress here.</p>
        </div>
    </div>
</div>

<!-- Optional: Raw logs collapsible -->
<div class="card collapsible collapsed" id="logs-card">
    <div class="card-header" onclick="toggleCollapse(this)">
        <h2>📋 Raw Logs</h2>
        <span class="collapse-icon">▼</span>
    </div>
    <div class="card-body">
        <div class="log-controls">
            <select id="log-level" onchange="filterLogs()">
                <option value="all">All Levels</option>
                <option value="info" selected>Info+</option>activity.html
                <option value="warning">Warning+</option>
                <option value="error">Error Only</option>
            </select>
            <button onclick="reconnectLogs()" class="small secondary">🔄 Reconnect</button>
        </div>
        <div class="log-viewer" id="log-viewer">
            <div id="log-content">Connecting...</div>
        </div>
    </div>
</div>

<!-- SABnzbd Queue Monitor -->
<div class="card collapsible" id="sab-card">
    <div class="card-header" onclick="toggleCollapse(this)">
        <h2>⬇️ SABnzbd Queue <span id="sab-badge" class="badge" style="display:none;">0</span></h2>
        <span class="collapse-icon">▼</span>
    </div>
    <div class="card-body">
        <div class="sab-summary" id="sab-summary">
            <div class="sab-stat">
                <span class="sab-stat-label">Speed</span>
                <span class="sab-stat-value" id="sab-speed">--</span>
            </div>
            <div class="sab-stat">
                <span class="sab-stat-label">Queue Size</span>
                <span class="sab-stat-value" id="sab-total-size">--</span>
            </div>
            <div class="sab-stat">
                <span class="sab-stat-label">Time Left</span>
                <span class="sab-stat-value" id="sab-timeleft">--</span>
            </div>
        </div>
        
        <div id="sab-motogp-queue">
            <div class="sab-empty">No MotoGP downloads in queue</div>
        </div>
        
        <div class="sab-footer">
            <span id="sab-last-update">Last update: --</span>
            <button onclick="refreshSabQueue()" class="small secondary">🔄 Refresh</button>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    let activitySource = null;
    let activities = {};
    const maxActivities = 50;
    
    // Activity stages with their order and display info (some stages are currently skipped in feed by design, see line 132)
    const stages = {
        'searching': { icon: '🔍', label: 'Searching', order: 1, color: '#3498db' },
        'found': { icon: '📋', label: 'Found candidates', order: 2, color: '#9b59b6' },
        'sending': { icon: '⬇️', label: 'Sending to SABnzbd', order: 3, color: '#f39c12' },
        'grabbed': { icon: '📥', label: 'Downloading then processing', order: 4, color: '#e67e22' },
        'downloading': { icon: '⬇️', label: 'Downloading', order: 5, color: '#e67e22' },
        'ready': { icon: '📂', label: 'Download complete', order: 6, color: '#27ae60' },
        'processing': { icon: '⚙️', label: 'Processing', order: 7, color: '#3498db' },
        'sorting': { icon: '📁', label: 'Applying PLEX metadata', order: 8, color: '#9b59b6' },
        'tagging': { icon: '🏷️', label: 'Applying Plex tags', order: 9, color: '#1abc9c' },
        'plex': { icon: '📺', label: 'Refreshing Plex', order: 10, color: '#e74c3c' },
        'complete': { icon: '✅', label: 'Ready in PLEX', order: 11, color: '#27ae60' },
        'error': { icon: '❌', label: 'Error', order: 99, color: '#e74c3c' }
    };
    
    function connectToActivity() {
        if (activitySource) {
            activitySource.close();
        }
        
        const indicator = document.getElementById('live-indicator');
        indicator.classList.remove('connected', 'disconnected');
        indicator.textContent = '● Connecting...';
        
        activitySource = new EventSource('/activity/stream');
        
        activitySource.onopen = function() {
            indicator.classList.add('connected');
            indicator.textContent = '● Live';
        };
        
        activitySource.onmessage = function(event) {
            try {
                const data = JSON.parse(event.data);
                processActivityEvent(data);
            } catch (e) {
                console.error('Error parsing activity event:', e);
            }
        };
        
        activitySource.onerror = function() {
            indicator.classList.remove('connected');
            indicator.classList.add('disconnected');
            indicator.textContent = '● Disconnected';
            setTimeout(connectToActivity, 5000);
        };
    }
    
    function processActivityEvent(event) {
    // Skip these stages from the feed
    const hiddenStages = ['plex', 'sending', 'tagging']
    if (hiddenStages.includes(event.stage)) {
        return;
    }
    
    const sessionKey = event.session_key || event.name || 'working....'
    
    if (!activities[sessionKey]) {
        activities[sessionKey] = {
            key: sessionKey,
            name: event.name || sessionKey,
            venue: event.venue || '',
            round: event.round || '',
            stage: 'searching',
            stages: {},
            lastUpdate: new Date(),
            release: null,
            score: null
        };
    }
    
    const activity = activities[sessionKey];
    activity.lastUpdate = new Date();
    
    // Update venue if provided (it might come in later events)
    if (event.venue && !activity.venue) {
        activity.venue = event.venue;
    }
    
    // Update based on event type
    if (event.stage) {
        activity.stage = event.stage;
        activity.stages[event.stage] = {
            time: new Date(),
            detail: event.detail || ''
        };
        
        // Auto-refresh SABnzbd queue when download starts
        if (event.stage === 'grabbed') {
            setTimeout(refreshSabQueue, 2000);
        }
    }
    
    if (event.release) activity.release = event.release;
    if (event.score) activity.score = event.score;
    if (event.candidates !== undefined) activity.candidates = event.candidates;
    if (event.error_message) activity.error_message = event.error_message;
    
    renderActivities();
}
    
    // Build display name with venue
    function getDisplayName(activity) {
        if (activity.venue && activity.name) {
            // Check if venue is already in the name to avoid duplication
            if (activity.name.toLowerCase().includes(activity.venue.toLowerCase())) {
                return activity.name;
            }
            return `${activity.venue} ${activity.name}`;
        }
        return activity.name || 'Unknown';
    }
    
    function renderActivities() {
        const feed = document.getElementById('activity-feed');
        
        // Sort by last update, newest first
        const sorted = Object.values(activities)
            .sort((a, b) => b.lastUpdate - a.lastUpdate)
            .slice(0, maxActivities);
        
        if (sorted.length === 0) {
            feed.innerHTML = '<div class="activity-empty"><p>No recent activity.</p></div>';
            return;
        }
        
        // Build a map of existing elements by key
        const existingElements = {};
        feed.querySelectorAll('.activity-item[data-key]').forEach(el => {
            existingElements[el.dataset.key] = el;
        });
        
        // Track which keys we've processed
        const processedKeys = new Set();
        
        sorted.forEach((activity, index) => {
            processedKeys.add(activity.key);
            const stageInfo = stages[activity.stage] || stages['searching'];
            const isComplete = activity.stage === 'complete';
            const isError = activity.stage === 'error';
            const displayName = getDisplayName(activity);
            
            let element = existingElements[activity.key];
            
            if (element) {
                // Update existing element in place
                updateActivityElement(element, activity, stageInfo, displayName, isComplete, isError);
            } else {
                // Create new element
                element = createActivityElement(activity, stageInfo, displayName, isComplete, isError);
                feed.appendChild(element);
            }
            
            // Ensure correct order
            if (feed.children[index] !== element) {
                feed.insertBefore(element, feed.children[index]);
            }
        });
        
        // Remove elements that are no longer in the list
        Object.keys(existingElements).forEach(key => {
            if (!processedKeys.has(key)) {
                existingElements[key].remove();
            }
        });
        
        // Remove empty message if present
        const emptyMsg = feed.querySelector('.activity-empty');
        if (emptyMsg && sorted.length > 0) {
            emptyMsg.remove();
        }
    }
    
    function createActivityElement(activity, stageInfo, displayName, isComplete, isError) {
        const div = document.createElement('div');
        div.className = `activity-item ${isComplete ? 'complete' : ''} ${isError ? 'error' : ''}`;
        div.dataset.key = activity.key;
        
        div.innerHTML = `
            <div class="activity-icon ${activity.stage}" style="background: ${stageInfo.color}">
                ${stageInfo.icon}
            </div>
            <div class="activity-content">
                <div class="activity-title">${escapeHtml(displayName)}</div>
                <div class="activity-status">${stageInfo.label}</div>
                <div class="activity-release" style="${activity.release ? '' : 'display:none'}">📦 ${escapeHtml(activity.release || '')}</div>
                <div class="activity-score" style="${activity.score ? '' : 'display:none'}">Score: ${activity.score || ''}</div>
                <div class="activity-candidates" style="${activity.candidates && activity.stage !== 'error' ? '' : 'display:none'}">${activity.candidates || ''} candidates found</div>
                <div class="activity-error" style="${activity.error_message ? '' : 'display:none'}">⚠️ ${activity.error_message || ''}</div>
            </div>
            <div class="activity-time">
                ${formatTime(activity.lastUpdate)}
            </div>
        `;
        
        return div;
    }
    
    function updateActivityElement(element, activity, stageInfo, displayName, isComplete, isError) {
        // Update classes
        element.className = `activity-item ${isComplete ? 'complete' : ''} ${isError ? 'error' : ''}`;
        
        // Update individual parts
        const icon = element.querySelector('.activity-icon');
        if (icon) {
            icon.style.background = stageInfo.color;
            icon.textContent = stageInfo.icon;
            icon.className = `activity-icon ${activity.stage}`;
        }
        
        const title = element.querySelector('.activity-title');
        if (title) title.textContent = displayName;
        
        const status = element.querySelector('.activity-status');
        if (status) status.textContent = stageInfo.label;
        
        const release = element.querySelector('.activity-release');
        if (release) {
            release.style.display = activity.release ? '' : 'none';
            if (activity.release) release.innerHTML = `📦 ${escapeHtml(activity.release)}`;
        }
        
        const score = element.querySelector('.activity-score');
        if (score) {
            score.style.display = activity.score ? '' : 'none';
            if (activity.score) score.textContent = `Score: ${activity.score}`;
        }
        
        const candidates = element.querySelector('.activity-candidates');
        if (candidates) {
            candidates.style.display = activity.candidates && activity.stage !== 'error' ? '' : 'none';
            if (activity.candidates) candidates.textContent = `${activity.candidates} candidates found`;
        }
        
        const errorMsg = element.querySelector('.activity-error');
        if (errorMsg) {
            errorMsg.style.display = activity.error_message ? '' : 'none';
            if (activity.error_message) errorMsg.innerHTML = `⚠️ ${activity.error_message}`;
        }
        
        const time = element.querySelector('.activity-time');
        if (time) time.textContent = formatTime(activity.lastUpdate);
    }
    
    function formatTime(date) {
        return date.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }
    
    function clearActivity() {
        activities = {};
        renderActivities();
    }
    
    // ===== SABnzbd Queue Monitor =====
    let sabPollInterval = null;
    const SAB_POLL_RATE = 15000; // 15 seconds

    function refreshSabQueue() {
        fetch('/api/sabnzbd/queue')
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    console.error('SABnzbd error:', data.error);
                    document.getElementById('sab-motogp-queue').innerHTML = 
                        `<div class="sab-error">⚠️ ${data.error}</div>`;
                    return;
                }
                
                updateSabDisplay(data);
            })
            .catch(err => {
                console.error('Failed to fetch SABnzbd queue:', err);
                document.getElementById('sab-motogp-queue').innerHTML = 
                    '<div class="sab-error">⚠️ Failed to connect to SABnzbd</div>';
            });
    }

    function updateSabDisplay(data) {
        // Update summary stats
        document.getElementById('sab-speed').textContent = data.speed || '--';
        document.getElementById('sab-total-size').textContent = data.total_sizeleft || '--';
        document.getElementById('sab-timeleft').textContent = data.timeleft || '--';
        document.getElementById('sab-last-update').textContent = 
            `Last update: ${new Date().toLocaleTimeString('en-GB')}`;
        
        // Update badge
        const badge = document.getElementById('sab-badge');
        if (data.motogp_count > 0) {
            badge.textContent = data.motogp_count;
            badge.style.display = 'inline-block';
        } else {
            badge.style.display = 'none';
        }
        
        // Update MotoGP downloads list
        const container = document.getElementById('sab-motogp-queue');
        
        if (data.motogp_downloads.length === 0) {
            container.innerHTML = '<div class="sab-empty">No MotoGP downloads in queue</div>';
            stopSabPolling();
            return;
        }
        
        let html = '<div class="sab-downloads">';
        data.motogp_downloads.forEach(dl => {
            const percent = parseInt(dl.percentage) || 0;
            html += `
                <div class="sab-download-item">
                    <div class="sab-download-header">
                        <span class="sab-filename" title="${escapeHtml(dl.filename)}">${escapeHtml(truncateFilename(dl.filename, 50))}</span>
                        <span class="sab-status ${dl.status.toLowerCase()}">${dl.status}</span>
                    </div>
                    <div class="sab-progress-container">
                        <div class="sab-progress-bar" style="width: ${percent}%"></div>
                    </div>
                    <div class="sab-download-details">
                        <span>${dl.sizeleft} / ${dl.size}</span>
                        <span>${percent}%</span>
                        <span>⏱️ ${dl.timeleft}</span>
                    </div>
                </div>
            `;
        });
        html += '</div>';
        
        container.innerHTML = html;
        
        // Keep polling while there are downloads
        startSabPolling();
    }

    function truncateFilename(filename, maxLength) {
        if (filename.length <= maxLength) return filename;
        return filename.substring(0, maxLength - 3) + '...';
    }

    function startSabPolling() {
        if (!sabPollInterval) {
            sabPollInterval = setInterval(refreshSabQueue, SAB_POLL_RATE);
        }
    }

    function stopSabPolling() {
        if (sabPollInterval) {
            clearInterval(sabPollInterval);
            sabPollInterval = null;
        }
    }

    // // Initial load
    // window.addEventListener('load', function() {
    //     // ... existing code ...
    //     refreshSabQueue();
    // });

    // window.addEventListener('beforeunload', function() {
    //     // ... existing code ...
    //     stopSabPolling();
    // });


    // Log viewer functions (simplified from logs.html)
    let logSource = null;
    let logLines = [];
    const maxLogLines = 500;
    let pendingLogUpdate = null;
    
    function connectToLogs() {
        if (logSource) logSource.close();
        
        const container = document.getElementById('log-content');
        container.textContent = 'Connecting...';
        
        logSource = new EventSource('/logs/stream');
        
        logSource.onmessage = function(event) {
            appendLogLine(event.data);
        };
        
        logSource.onerror = function() {
            // Don't spam reconnection attempts
            setTimeout(connectToLogs, 5000);
        };
    }
    
    function appendLogLine(text) {
        logLines.push(text);
        if (logLines.length > maxLogLines) logLines.shift();
        
        // Debounce updates to prevent excessive redraws
        if (pendingLogUpdate) return;
        
        pendingLogUpdate = requestAnimationFrame(() => {
            pendingLogUpdate = null;
            renderLogs();
        });
    }
    
    function renderLogs() {
        const container = document.getElementById('log-content');
        const filterLevel = document.getElementById('log-level').value;
        
        // Check if log viewer is collapsed - skip heavy rendering if so
        const logsCard = document.getElementById('logs-card');
        if (logsCard && logsCard.classList.contains('collapsed')) {
            return; // Don't render if collapsed
        }
        
        const filtered = logLines.filter(line => shouldShowLine(line, filterLevel));
        
        // Use DocumentFragment for better performance
        const fragment = document.createDocumentFragment();
        
        filtered.forEach(line => {
            const div = document.createElement('div');
            div.className = 'log-line';
            if (line.includes('[ERROR]')) div.classList.add('error');
            else if (line.includes('[WARNING]')) div.classList.add('warning');
            else if (line.includes('[INFO]')) div.classList.add('info');
            div.textContent = line;
            fragment.appendChild(div);
        });
        
        container.innerHTML = '';
        container.appendChild(fragment);
        container.scrollTop = container.scrollHeight;
    }
    
    function shouldShowLine(line, level) {
        if (level === 'all') return true;
        if (level === 'error') return line.includes('[ERROR]');
        if (level === 'warning') return line.includes('[ERROR]') || line.includes('[WARNING]');
        if (level === 'info') return !line.includes('[DEBUG]');
        return true;
    }
    
    function filterLogs() {
        renderLogs();
    }
    
    function reconnectLogs() {
        logLines = [];
        connectToLogs();
    }
    
    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
    
    // Custom toggle that preserves state
    function toggleCollapse(header) {
        const card = header.closest('.collapsible');
        if (card) {
            card.classList.toggle('collapsed');
            // If we just expanded the logs, render them
            if (!card.classList.contains('collapsed') && card.id === 'logs-card') {
                renderLogs();
            }
        }
    }
    
    // Initialize
    window.addEventListener('load', function() {
        connectToActivity();
        connectToLogs();
        refreshSabQueue();
    });
    
    window.addEventListener('beforeunload', function() {
        if (activitySource) activitySource.close();
        if (logSource) logSource.close();
        stopSabPolling();
    });
</script>
{% endblock %}