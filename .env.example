# MotoGParr Environment Variables
# ================================
# These can be used instead of settings.yml
# Copy to .env and fill in your values

# Prowlarr
PROWLARR_URL=http://192.168.1.100:9696
PROWLARR_API_KEY=your_prowlarr_api_key

# SABnzbd
SABNZBD_URL=http://192.168.1.100:8080
SABNZBD_API_KEY=your_sabnzbd_api_key

# Plex
PLEX_URL=http://192.168.1.100:32400
PLEX_TOKEN=your_plex_token
PLEX_LIBRARY_ID=16
PLEX_LIBRARY_NAME=Motorsport - MotoGP

# Path Mapping (container path -> Plex path)
# Used to translate paths between this container and Plex
PLEX_PATH_CONTAINER=/media
PLEX_PATH_PLEX=/data/media

# Paths (as seen inside this container)
MOTOGP_LIBRARY_PATH=/media/Motorssport/MotoGP
MOTOGP_DOWNLOADS_PATH=/downloads/complete/motogp

# Discord (optional)
DISCORD_WEBHOOK_URL=

# Timezone
TZ=Europe/London